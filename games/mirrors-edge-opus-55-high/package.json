{
  "name": "rooftop-flow",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "ROOFTOP FLOW - a first-person browser parkour game built with Three.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && cf build",
