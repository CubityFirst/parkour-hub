  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^2.0.0-beta.v.8",
    "@cloudflare/workers-types": "^5.20261013.1",
    "@types/node": "^26.6.5",
    "@types/three": "^0.186.0",
    "cf": "^1.0.0-beta.19",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "wrangler": "^4.150.0"
  }
